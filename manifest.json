{
  "manifest_version": 3,
  "name": "Rádio Tabblet",
  "version": "1.1.0",
  "description": "Ouça a Rádio Tabblet e escolha canais PluZ no Habblet, com temas sazonais e preferências salvas.",
  "icons": {
    "16": "tabblet.png",
    "32": "tabblet.png",
    "48": "tabblet.png",
    "128": "tabblet.png"
  },
  "action": {
    "default_icon": {
      "16": "tabblet.png",
      "32": "tabblet.png",
      "48": "tabblet.png",
      "128": "tabblet.png"
    },
    "default_title": "Rádio Tabblet"
  },
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src https://audio.tabblet.net https://streaming.pluz.fm;"
  },
  "host_permissions": [
    "https://www.habblet.city/*",
    "https://habblet.city/*",
    "https://tabblet.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.habblet.city/hotel*",
        "https://habblet.city/hotel*"
      ],
      "js": [
        "radio-core.js",
        "player-ui.js",
        "player-placement.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tabblet.net/*"
      ],
      "js": [
        "site-actions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120",
  "web_accessible_resources": [
    {
      "resources": [
        "player.css",
        "assets/themes/*/*.webp"
      ],
      "matches": [
        "https://www.habblet.city/*",
        "https://habblet.city/*"
      ]
    }
  ]
}
